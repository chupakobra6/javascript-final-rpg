{
  "name": "javascript-final-rpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jest": "30.5.2"
  },
  "jest": {
    "transform": {},
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageReporters": [
      "text",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  }
}
